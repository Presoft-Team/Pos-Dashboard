# Real SQL Server (AutoCount/Presoft account book). Copy this file to
# `.env`, fill in the real values there — never commit real credentials,
# never paste them in chat.
#
# Named instance (e.g. "DESKTOP-26VS865\A2006" — a backslash + instance
# name after the host)? Leave MSSQL_PORT UNSET/blank. Named instances don't
# listen on a fixed port like 1433 — the driver resolves the real port via
# SQL Server Browser (needs that service running, UDP 1434 reachable) using
# the instance name parsed out of MSSQL_HOST automatically. Setting
# MSSQL_PORT overrides this entirely and connects to that exact port
# instead (use if you've looked up the instance's actual static port in
# SQL Server Configuration Manager, or Browser isn't available).
MSSQL_HOST=your-host-or-host\instance
MSSQL_PORT=
MSSQL_DATABASE=AED_Presoft
MSSQL_USER=your-sql-login
MSSQL_PASSWORD=your-sql-password
# Only set these if the connection fails on certificate validation:
# MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERT=true

# Local Express server port (separate from the Next.js dashboard app's 3000)
PORT=4000
