JWT_SECRET=
MASTER_ADMIN_DATABASE_URL=postgresql://admin:admin_local_dev@localhost:5432/master_admin
MASTER_ADMIN_ENCRYPTION_PASSPHRASE=demo-passphrase

# This app signs its own session JWTs now (see lib/auth/jwt.ts) — it no
# longer needs to match any external service's secret.

# MASTER_ADMIN_DATABASE_URL points at the master-admin Postgres DB (business/
# customer/member — tenant identity + each business's own presoft-api
# api_url/api_key). Login now queries this DB directly instead of proxying
# to presoft-api (see app/api/auth/login/route.ts). Default above matches
# the master-admin repo's docker-compose.yml for local dev.
#
# MASTER_ADMIN_ENCRYPTION_PASSPHRASE must match the passphrase used by
# pgp_sym_encrypt() when a business's api_key was written — the master-admin
# repo's seed data used the literal 'demo-passphrase', kept here as the
# local-dev default. Rotate for anything beyond local dev, and re-encrypt
# existing business.api_key rows if you do.
#
# PRESOFT_API_URL / PRESOFT_API_KEY (previously here) are gone — each
# business's own api_url/api_key now live in the business table and are
# resolved per-request (see lib/presoft-api.ts), not one global value.
