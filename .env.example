PRESOFT_API_URL=http://localhost:8099
PRESOFT_API_KEY=

# --- Per-client login (new) ---
# Set these two to enable multi-tenant login: each signed-in client's own
# AutoCount write-service URL/API key (managed in the separate
# license-portal app) is then used automatically instead of the
# PRESOFT_API_URL/PRESOFT_API_KEY above, which remain as the fallback for
# deployments that haven't rolled this out yet (no login page, same as
# before).
#
# DATABASE_URL: same Railway Postgres connection string / `clients` table
# that license-portal writes to.
DATABASE_URL=
# SESSION_SECRET: any random string (openssl rand -hex 32) — signs this
# app's own login session cookie. Can differ from license-portal's secret.
SESSION_SECRET=
