PRESOFT_API_URL=http://localhost:4000
PRESOFT_API_KEY=
JWT_SECRET=

# No NEXT_PUBLIC_ prefix on either of these — the browser never talks to
# presoft-api directly anymore (see app/api/presoft/[name]/route.ts and
# app/api/auth/login/route.ts), only this server does, so neither the URL
# nor the key should be inlined into the client bundle.

# Must be the exact same value as presoft-api's API_KEY.

# Verifies the JWT issued by presoft-api's POST /api/v1/auth/login. Must be
# the exact same value as presoft-api's JWT_SECRET — generate one long
# random string and copy it into both projects' env files.