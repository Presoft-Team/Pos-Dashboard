NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Real SQL Server (AED_Presoft account book) — see PLAN.md §1/§6/§8.
# NOTE: as of the switch to calling presoft-api directly (§8), the dashboard
# app itself no longer uses these at runtime — lib/mssql.ts, lib/db/queries/*,
# and app/api/rpc/[name] are currently unused/orphaned, not deleted (still
# there as a fallback if presoft-api ever gets folded back in). Kept here in
# case that changes; not required for the app to run right now.
# Get these values from whoever opens the tunnel / owns the SQL Server
# instance, then put the real values in .env.local (never here, never in chat).
#
# Named instance (e.g. "DESKTOP-26VS865\A2006" — a backslash + instance
# name after the host)? Leave MSSQL_PORT UNSET/blank. Named instances don't
# listen on a fixed port like 1433 — the driver resolves the real port via
# SQL Server Browser (needs that service running, UDP 1434 reachable) using
# the instance name parsed out of MSSQL_HOST automatically. Setting
# MSSQL_PORT overrides this entirely and connects to that exact port
# instead (use this if you've looked up the instance's actual static port
# in SQL Server Configuration Manager, or Browser isn't available).
MSSQL_HOST=your-host-or-host\instance
MSSQL_PORT=
MSSQL_DATABASE=AED_Presoft
MSSQL_USER=your-sql-login
MSSQL_PASSWORD=your-sql-password
# Only set these if the connection fails on certificate validation:
# MSSQL_ENCRYPT=false
# MSSQL_TRUST_SERVER_CERT=true

# Where the dashboard app's data now comes from — the standalone presoft-api
# service (see PLAN.md §8), not this app's own /api/rpc/[name] anymore.
# NEXT_PUBLIC_ because lib/db/client.ts fetches this from the browser.
# Defaults to http://localhost:4000 if unset.
NEXT_PUBLIC_PRESOFT_API_URL=http://localhost:4000
