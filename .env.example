# The IIS site hosting presoft-api. Either form works; "http://" is added
# if you leave it off:
#
#   PRESOFT_API_URL=192.168.1.10:9000
#   PRESOFT_API_URL=http://192.168.1.10:9000
#
# Must be an address THIS server can reach. "localhost"/"127.0.0.1" only
# works if presoft-api runs on the same machine as this dashboard.
PRESOFT_API_URL=192.168.1.10:9000

# Sent as the x-api-key header on every call. Server-only — never
# NEXT_PUBLIC_-prefixed, so it stays out of the browser bundle; the browser
# only ever talks to this app's own /api/presoft/* routes, which attach the
# key server-side.
PRESOFT_API_KEY=

# Which account book to query. Data endpoints take a POST body of
# { CompanyId, FromDateTime, ToDateTime }; CompanyId is the same for every
# call in a deployment, so it lives here and is filled in server-side.
PRESOFT_COMPANY_ID=

# Put these in .env (or .env.local) in the project root. Next reads env
# files ONCE at startup — editing one while `npm run dev` is running has no
# effect until you fully stop and restart it.
