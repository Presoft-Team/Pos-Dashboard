PRESOFT_API_URL=http://localhost:4000
PRESOFT_API_KEY=

# No NEXT_PUBLIC_ prefix on either of these — the browser never talks to
# presoft-api directly (see app/api/presoft/[name]/route.ts), only this
# server does, so neither the URL nor the key should be inlined into the
# client bundle.

# Must be the exact same value as presoft-api's API_KEY.
